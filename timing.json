 "total": 25.197,
 "segments": [
  {
   "i": 0,
   "text": "體重卡住了，先別慌。",
   "start": 0.6,
   "end": 2.65
  },
  {
   "i": 1,
   "text": "這就是停滯期，也就是減重路上的魔王關。",
   "start": 2.93,
   "end": 6.489
  },
  {
   "i": 2,
   "text": "這是身體的生理反應，不是你失敗。",
   "start": 6.769,
   "end": 9.752
  },
  {
   "i": 3,
   "text": "先不要急著吃更少。",
   "start": 10.032,
   "end": 11.717
  },
  {
   "i": 4,
   "text": "打贏魔王靠三招：",
   "start": 11.997,
   "end": 13.465
  },
  {
   "i": 5,
   "text": "肌力訓練加量，",
   "start": 13.615,
   "end": 14.902
  },
  {
   "i": 6,
   "text": "把步數補回來，",
   "start": 15.182,
   "end": 16.375
  },
  {
   "i": 7,
   "text": "吃得抗餓。",
   "start": 16.655,
   "end": 17.6
  },
  {
   "i": 8,
   "text": "腸泌素針劑不要自己停，",
   "start": 17.88,
   "end": 19.9
  },
  {
   "i": 9,
   "text": "卡超過兩個月，回診我們一起找原因。",
   "start": 20.18,
   "end": 23.317
  }
 ]
}