 "segments": [
  {
   "s": 0,
   "i": 0,
   "sub": "健康旅程攻略",
   "start": 1.4,
   "end": 2.719
  },
  {
   "s": 0,
   "i": 1,
   "sub": "減重・營養・運動・好習慣",
   "start": 3.039,
   "end": 5.989
  },
  {
   "s": 0,
   "i": 2,
   "sub": "整條路先畫給你看，關卡標清楚，一關一關破",
   "start": 6.309,
   "end": 10.569
  },
  {
   "s": 1,
   "i": 0,
   "sub": "第 1 單元：減重。先看懂地圖，再出發",
   "start": 12.389,
   "end": 16.916
  },
  {
   "s": 2,
   "i": 0,
   "sub": "減重像破關：一共五關",
   "start": 18.436,
   "end": 20.66
  },
  {
   "s": 2,
   "i": 1,
   "sub": "起始期、減重期、停滯期、維持期、過渡期",
   "start": 20.98,
   "end": 25.774
  },
  {
   "s": 2,
   "i": 2,
   "sub": "會卡住，是荷爾蒙的設定，不是你不努力",
   "start": 26.094,
   "end": 29.719
  },
  {
   "s": 3,
   "i": 0,
   "sub": "停滯期＝魔王關",
   "start": 31.739,
   "end": 33.767
  },
  {
   "s": 3,
   "i": 1,
   "sub": "體重卡住，是荷爾蒙在調控，不是你不努力",
   "start": 34.087,
   "end": 37.921
  },
  {
   "s": 3,
   "i": 2,
   "sub": "打到魔王關，代表你已經走很遠了",
   "start": 38.241,
   "end": 41.16
  },
  {
   "s": 3,
   "i": 3,
   "sub": "攻略我們有——不要放棄，就是破關的關鍵",
   "start": 41.48,
   "end": 45.059
  },
  {
   "s": 4,
   "i": 0,
   "sub": "不是在考驗意志力",
   "start": 47.279,
   "end": 48.834
  },
  {
   "s": 4,
   "i": 1,
   "sub": "用藥後覺得不太想吃？",
   "start": 49.154,
   "end": 50.878
  },
  {
   "s": 4,
   "i": 2,
   "sub": "那是藥在把「一直想吃」的訊號關小聲",
   "start": 51.198,
   "end": 54.065
  },
  {
   "s": 4,
   "i": 3,
   "sub": "代表藥有發揮作用",
   "start": 54.385,
   "end": 56.031
  },
  {
   "s": 4,
   "i": 4,
   "sub": "把力氣花在「怎麼吃」，而不是「忍住不吃」",
   "start": 56.351,
   "end": 59.556
  },
  {
   "s": 5,
   "i": 0,
   "sub": "用藥的朋友，記住三件事",
   "start": 61.376,
   "end": 63.732
  },
  {
   "s": 5,
   "i": 1,
   "sub": "每週固定同一天打，手機設好提醒",
   "start": 64.052,
   "end": 67.194
  },
  {
   "s": 5,
   "i": 2,
   "sub": "肚皮、大腿、上臂，輪流換位置",
   "start": 67.514,
   "end": 70.906
  },
  {
   "s": 5,
   "i": 3,
   "sub": "不舒服就回來討論——劑量可以商量，不要自己停藥",
   "start": 71.226,
   "end": 75.587
  },
  {
   "s": 6,
   "i": 0,
   "sub": "第 2 單元：營養。吃對順序，比吃很少重要",
   "start": 77.407,
   "end": 82.375
  },
  {
   "s": 7,
   "i": 0,
   "sub": "每餐先吃蛋白質",
   "start": 83.895,
   "end": 85.452
  },
  {
   "s": 7,
   "i": 1,
   "sub": "蛋、豆腐、豆漿、魚、雞肉",
   "start": 85.772,
   "end": 88.69
  },
  {
   "s": 7,
   "i": 2,
   "sub": "先吃夠蛋白質，才不會瘦到肌肉",
   "start": 89.01,
   "end": 92.028
  },
  {
   "s": 7,
   "i": 3,
   "sub": "吃完蛋白質，再吃青菜，最後才是飯麵",
   "start": 92.348,
   "end": 96.192
  },
  {
   "s": 8,
   "i": 0,
   "sub": "外食這樣選",
   "start": 98.412,
   "end": 99.495
  },
  {
   "s": 8,
   "i": 1,
   "sub": "自助餐：先夾蛋白質，再夾兩樣青菜",
   "start": 99.815,
   "end": 103.461
  },
  {
   "s": 8,
   "i": 2,
   "sub": "便當：炸物去皮、醬汁不淋飯",
   "start": 103.781,
   "end": 106.729
  },
  {
   "s": 8,
   "i": 3,
   "sub": "湯麵：麵吃一半、湯少喝幾口",
   "start": 107.049,
   "end": 110.066
  },
  {
   "s": 9,
   "i": 0,
   "sub": "含糖飲料，換成無糖",
   "start": 111.886,
   "end": 114.014
  },
  {
   "s": 9,
   "i": 1,
   "sub": "無糖茶、白開水，都是好選擇",
   "start": 114.334,
   "end": 117.348
  },
  {
   "s": 9,
   "i": 2,
   "sub": "胃口變小的現在，正是戒糖飲最容易成功的時機",
   "start": 117.668,
   "end": 121.68
  },
  {
   "s": 10,
   "i": 0,
   "sub": "水要喝夠，青菜要夠",
   "start": 123.7,
   "end": 125.809
  },
  {
   "s": 10,
   "i": 1,
   "sub": "水少量多次喝，一天分好幾次補充",
   "start": 126.129,
   "end": 129.339
  },
  {
   "s": 10,
   "i": 2,
   "sub": "每餐至少一份青菜，纖維幫助腸胃順暢",
   "start": 129.659,
   "end": 133.326
  },
  {
   "s": 11,
   "i": 0,
   "sub": "想吐的時候，這樣吃",
